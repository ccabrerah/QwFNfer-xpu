+// GGML_SYCL_FUSE_MULTI_MMV (patch 39): patch 28's kernel over the rows of two or three weights in one launch. Global
+// row r belongs to weight k when off[k] <= r < off[k + 1] and is that weight's row r - off[k]; from there the body is
+// patch 28's, character for character (the same loads, per-column accumulation and sub-group reduction), with the
+// weight's own base, row count and output.
+template <int NC>
+static void reorder_mul_mat_vec_q8_0_q8_1_wide_ncols_multi_sycl(const ggml_sycl_q8w_multi & m, const void * vy, const int ncols,
+                                                                const int stride_col_y_bytes, dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK8_0 == 0);
+    constexpr int sg_per_wg = 8;
+    const int     nb        = ncols / QK8_0;
+    struct wts { const void * vx[3]; float * dst[3]; int nrows[3]; int off[4]; } w{};
+    int total = 0;
+    for (int k = 0; k < 3; k++) {
+        w.off[k] = total;
+        if (k < m.n) { w.vx[k] = m.vx[k]; w.dst[k] = m.dst[k]; w.nrows[k] = m.nrows[k]; total += m.nrows[k]; }
+    }
+    w.off[3] = total;
+    for (int k = m.n; k < 3; k++) w.off[k] = total;   // unused weights start past the last row
+    const int n_wg = ceil_div(total, sg_per_wg);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * sg_per_wg * WARP_SIZE), sycl::range<1>(sg_per_wg * WARP_SIZE)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const sycl::sub_group sg   = it.get_sub_group();
+            const int             grow = (int) it.get_group(0) * sg_per_wg + (int) sg.get_group_linear_id();
+            if (grow >= w.off[3]) {
+                return;   // the whole sub-group shares the row
+            }
+            const int     k      = grow < w.off[1] ? 0 : grow < w.off[2] ? 1 : 2;
+            const int     row    = grow - w.off[k];
+            const int     nrows  = w.nrows[k];
+            const void *  vx     = w.vx[k];
+            float *       dst    = w.dst[k];
+            const size_t  d_base = (size_t) ncols * nrows;   // scales follow all quants: [qs0|...|qsN][d0|...|dN]
+            const int         lane = sg.get_local_linear_id();
+            const int8_t *    xq   = (const int8_t *) vx + (size_t) row * nb * QK8_0;
+            const ggml_half * xd   = (const ggml_half *) ((const char *) vx + d_base) + (size_t) row * nb;
+            float             sum[NC];
+#pragma unroll
+            for (int c = 0; c < NC; c++) {
+                sum[c] = 0.0f;
+            }
+#pragma unroll 2
+            for (int i = lane; i < nb; i += WARP_SIZE) {
+                const sycl::int4 * xv = (const sycl::int4 *) (xq + (size_t) i * QK8_0);
+                const sycl::int4   x0 = xv[0], x1 = xv[1];
+                const float        dx = static_cast<float>(xd[i]);
+#pragma unroll
+                for (int c = 0; c < NC; c++) {
+                    const char *        vyc = (const char *) vy + (size_t) c * stride_col_y_bytes;
+                    const sycl::int4 *  yv  = (const sycl::int4 *) ((const int8_t *) vyc + (size_t) i * QK8_1);
+                    const sycl::half2 * yds = (const sycl::half2 *) (vyc + ncols);
+                    const sycl::int4    y0 = yv[0], y1 = yv[1];
+                    int                 sq = 0;
+#pragma unroll
+                    for (int j = 0; j < 4; j++) {
+                        sq = dpct::dp4a(x0[j], y0[j], sq);
+                    }
+#pragma unroll
+                    for (int j = 0; j < 4; j++) {
+                        sq = dpct::dp4a(x1[j], y1[j], sq);
+                    }
+                    sum[c] += dx * static_cast<float>(yds[i][0]) * sq;
+                }
+            }
+#pragma unroll
+            for (int c = 0; c < NC; c++) {
+                const float r = sycl::reduce_over_group(sg, sum[c], sycl::plus<float>());
+                if (lane == 0) {
+                    dst[(size_t) c * nrows + row] = r;
+                }
+            }
+        });
+}
