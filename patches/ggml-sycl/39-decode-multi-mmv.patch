+bool ggml_sycl_mul_mat_vec_q8w_multi(const ggml_sycl_q8w_multi & m, const void * vy, int ncols, int ncols_dst,
+                                     int stride_col_y_bytes, dpct::queue_ptr stream) {
+    if (!ggml_sycl_q8w_multi_enabled() || m.n < 2 || m.n > 3 || ncols % QK8_0 != 0) {
+        return false;
+    }
+    switch (ncols_dst) {
+        case 2: reorder_mul_mat_vec_q8_0_q8_1_wide_ncols_multi_sycl<2>(m, vy, ncols, stride_col_y_bytes, stream); return true;
+        case 3: reorder_mul_mat_vec_q8_0_q8_1_wide_ncols_multi_sycl<3>(m, vy, ncols, stride_col_y_bytes, stream); return true;
+        case 4: reorder_mul_mat_vec_q8_0_q8_1_wide_ncols_multi_sycl<4>(m, vy, ncols, stride_col_y_bytes, stream); return true;
+        default: return false;
+    }
+}
