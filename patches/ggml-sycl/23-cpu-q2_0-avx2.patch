From: Carlos Cabrera H. <6750732+ccabrerah@users.noreply.github.com>
Subject: [PATCH 23] ggml-cpu: AVX2 ggml_vec_dot_q2_0_q8_0

x86 had only the scalar loop for Q2_0 x Q8_0 (arch-fallback.h). 2-bit codes unpacked to bytes, offset to {-1,0,1,2},
mul_sum_i8_pairs_float against each Q8_0 half, FMA-accumulated in a float vector as ggml_vec_dot_q4_0_q8_0 does.
One expert's gate+up (1280 x 2560) on one core: 394 -> 150 us; max error 2.7e-8 of sum|w*a| vs 5.2e-8 scalar.

diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -1505,6 +1505,52 @@
 #endif
 }
 
+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK2_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+
+#if defined(__AVX2__)
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_0 * GGML_RESTRICT x = vx;
+    const block_q8_0 * GGML_RESTRICT y = vy;   // two Q8_0 blocks per Q2_0 block (64 = 2 x 32)
+
+    const __m128i m3  = _mm_set1_epi8(3);
+    const __m256i one = _mm256_set1_epi8(1);
+    __m256 acc = _mm256_setzero_ps();
+
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        // value j sits in byte j/4 at bits 2*(j%4): split the four bit pairs, then interleave back to value order
+        const __m128i b  = _mm_loadu_si128((const __m128i *) x[i].qs);
+        const __m128i c0 = _mm_and_si128(b, m3);
+        const __m128i c1 = _mm_and_si128(_mm_srli_epi16(b, 2), m3);
+        const __m128i c2 = _mm_and_si128(_mm_srli_epi16(b, 4), m3);
+        const __m128i c3 = _mm_and_si128(_mm_srli_epi16(b, 6), m3);
+        const __m128i a0 = _mm_unpacklo_epi8(c0, c1), a1 = _mm_unpacklo_epi8(c2, c3);   // code bytes 0..7: values 0..31
+        const __m128i e0 = _mm_unpackhi_epi8(c0, c1), e1 = _mm_unpackhi_epi8(c2, c3);   // code bytes 8..15: values 32..63
+        const __m256i q0 = _mm256_sub_epi8(MM256_SET_M128I(_mm_unpackhi_epi16(a0, a1), _mm_unpacklo_epi16(a0, a1)), one);
+        const __m256i q1 = _mm256_sub_epi8(MM256_SET_M128I(_mm_unpackhi_epi16(e0, e1), _mm_unpacklo_epi16(e0, e1)), one);
+
+        const __m256 p0 = mul_sum_i8_pairs_float(q0, _mm256_loadu_si256((const __m256i *) y[2*i + 0].qs));
+        const __m256 p1 = mul_sum_i8_pairs_float(q1, _mm256_loadu_si256((const __m256i *) y[2*i + 1].qs));
+        acc = _mm256_fmadd_ps(_mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2*i + 0].d)), p0, acc);
+        acc = _mm256_fmadd_ps(_mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2*i + 1].d)), p1, acc);
+    }
+
+    *s = hsum_float_8(acc);
+#else
+    UNUSED(nb);
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
 void ggml_vec_dot_tq2_0_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     assert(nrc == 1);
     UNUSED(nrc);
diff --git a/ggml/src/ggml-cpu/arch-fallback.h b/ggml/src/ggml-cpu/arch-fallback.h
--- a/ggml/src/ggml-cpu/arch-fallback.h
+++ b/ggml/src/ggml-cpu/arch-fallback.h
@@ -83,7 +83,6 @@
 #define ggml_gemm_q2_K_8x8_q8_K_generic ggml_gemm_q2_K_8x8_q8_K
 #elif defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
 // quants.c
-#define ggml_vec_dot_q2_0_q8_0_generic ggml_vec_dot_q2_0_q8_0
 // repack.cpp
 #define ggml_quantize_mat_q8_0_4x4_generic ggml_quantize_mat_q8_0_4x4
 #define ggml_quantize_mat_q8_K_4x4_generic ggml_quantize_mat_q8_K_4x4
