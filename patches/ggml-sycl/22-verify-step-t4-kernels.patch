     scope_op_debug_print scope_dbg_print(__func__, glu, /*num_src=*/2, " : q2_0 MoE gate + up + swiglu");
     const queue_ptr stream = ctx.stream();
     const int padded = GGML_PAD((int) K, MATRIX_ROW_PADDING);
