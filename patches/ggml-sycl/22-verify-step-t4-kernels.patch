+    const int y_tok_blocks = padded / QK8_1;
+    ggml_sycl_pool_alloc<char> q8(ctx.pool(), (size_t) T * padded * sizeof(block_q8_1) / QK8_1);
+    if (T == 1 || padded == K) {   // the rows are one flat run of 32-value blocks
+        quantize_row_q8_1_sycl<quantize_q8_1>((const float *) x->data, q8.get(), (int) K, (int) T, padded, stream);
+    } else {
+        for (int64_t t = 0; t < T; t++)
