+// GGML_SYCL_FUSE_MULTI_MMV_GLU (patch 40): a GLU's gate and up weights (same rows, reorder layout) against the same 2-4
+// quantized columns: one sub-group computes row r of the gate, then row r of the up, each as patch 28's kernel computes
+// it, and writes the GLU kernel's silu(gate) * up per column. The two products never reach memory.
+template <int NC>
+static void reorder_mul_mat_vec_q8_0_q8_1_wide_ncols_glu_sycl(const void * vx_gate, const void * vx_up, const void * vy, float * dst,
+                                                              const int ncols, const int nrows, const int stride_col_y_bytes,
+                                                              dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK8_0 == 0);
+    constexpr int sg_per_wg = 8;
+    const int     n_wg      = ceil_div(nrows, sg_per_wg);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * sg_per_wg * WARP_SIZE), sycl::range<1>(sg_per_wg * WARP_SIZE)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const sycl::sub_group sg  = it.get_sub_group();
+            const int             row = (int) it.get_group(0) * sg_per_wg + (int) sg.get_group_linear_id();
+            if (row >= nrows) {
+                return;   // the whole sub-group shares the row
+            }
+            float g[NC], u[NC];
+            q8w_ncols_row<NC>(vx_gate, vy, ncols, nrows, row, stride_col_y_bytes, sg, g);
+            q8w_ncols_row<NC>(vx_up,   vy, ncols, nrows, row, stride_col_y_bytes, sg, u);
+            if (sg.get_local_linear_id() == 0) {
+#pragma unroll
+                for (int c = 0; c < NC; c++) {
+                    dst[(size_t) c * nrows + row] = op_silu(g[c]) * u[c];
+                }
+            }
+        });
+}
