+// arithmetic is the kernel above's: the lane's 8 products in the same order, the same sub-group reduction, the heads'
+// relu * weight added on lane 0 in head order, then the mask.
+static void lightning_indexer_decode_f16_sycl(
+        const char * q, const char * k, const char * w, const char * m, float * dst,
+        int n_embd, int n_head, int n_batch, int n_kv,
+        size_t nbq1, size_t nbq2, size_t nbk2, size_t nbw1, size_t nbm1, size_t nb1,
+        queue_ptr stream) {
+    constexpr int LANES = WARP_SIZE;
+    constexpr int ELEMS_PER_LANE = 8;
+    constexpr int ROWS_PER_BLOCK = 4;
+    constexpr int BLOCK_SIZE = ROWS_PER_BLOCK * LANES;
+    const int n_blocks = (n_kv + ROWS_PER_BLOCK - 1) / ROWS_PER_BLOCK;
+    const size_t dst_b = nb1 / sizeof(float);
+
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_blocks * BLOCK_SIZE), sycl::range<1>(BLOCK_SIZE)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int lane = (int) item.get_local_id(0) % LANES;
+            const int i_kv = (int) item.get_group(0) * ROWS_PER_BLOCK + (int) item.get_local_id(0) / LANES;
+            if (i_kv >= n_kv) {
+                return;   // the whole sub-group shares the row
+            }
+            const sycl::half * k_row = (const sycl::half *) (k + (size_t) i_kv * nbk2);
+            float k_local[ELEMS_PER_LANE];
+#pragma unroll
+            for (int j = 0; j < ELEMS_PER_LANE; ++j) {
+                k_local[j] = static_cast<float>(k_row[lane*ELEMS_PER_LANE + j]);
+            }
