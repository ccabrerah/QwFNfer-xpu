+    const size_t src1_row_stride, const size_t y_tok_stride,
+    const sycl::nd_item<3> & it) {
+    constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+    const int pair       = it.get_group(1);
+    const int tok        = pair / n_ids;
+    const int expert_idx = pair - tok * n_ids;
+    const int i02        = ids_dev[(size_t) tok * ids_tok_stride + expert_idx];
+    const int lane       = it.get_local_id(2);
+    const int row        = (it.get_group(2) * it.get_local_range(1) + it.get_local_id(1)) * ROWS_PER_SG + lane / LPR;
+    const int t          = lane % LPR;
+
+    const uint8_t *    slice = (const uint8_t *) vx_base + (size_t) i02 * expert_weight_stride;
+    const block_q8_1 * y     = (const block_q8_1 *) ((const char *) vy_base + (size_t) tok * y_tok_stride + (size_t) expert_idx * src1_row_stride);
