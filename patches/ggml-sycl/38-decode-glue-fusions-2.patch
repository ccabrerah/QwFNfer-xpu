+// GGML_SYCL_FUSE_CONV_T: the DeltaNet short conv of a step of 2-4 positions (f3_conv takes one position), as the engine
+// builds it: CONCAT(state [hist, C], x^T [T, C]) along dim 0 -> CPY of its last hist columns to the state (the new state)
+// -> CPYs of earlier hist-column tails to the rollback slots -> SSM_CONV of the concat -> SILU, the next nodes the loop
+// runs. One work-item per channel reads its state row and its T inputs, then writes the new state and the snapshots, and
+// (mode 1) the conv outputs, as ssm_conv_element<DC> computes them (the same loop, unrolled for 4 taps as the stock
+// kernel is, and op_silu), or (mode 2) the concat, leaving the conv + SiLU to the stock kernel: copies only, exact by
+// construction. In mode 1 the concat is not written: its only readers are the copies' views and the conv. The SiLU output
+// may be x^T's own memory element for element (the allocator gives the conv the input projection's buffer, dead after
+// the concat): each work-item reads its channel's T inputs before it writes their outputs, and no other work-item reads them.
+struct glue_conv_t {
+    ggml_tensor *       cat = nullptr;
+    const ggml_tensor * conv = nullptr;
+    ggml_tensor *       silu = nullptr, * state = nullptr;
+    ggml_tensor *       snap[4] = {};
+    int64_t             snap_off[4] = {};
+    int                 n_snap = 0, last = -1;
+};
+
+static bool glue_conv_t_match(const ggml_cgraph * g, int i, int mode, glue_conv_t & m) {
+    m = glue_conv_t{};
+    ggml_tensor * cat = g->nodes[i];
+    if (cat->op != GGML_OP_CONCAT || cat->op_params[0] != 0 || cat->type != GGML_TYPE_F32 || (cat->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+    const ggml_tensor * st = cat->src[0], * xt = cat->src[1];
+    if (!st || !xt || st->type != GGML_TYPE_F32 || xt->type != GGML_TYPE_F32) return false;
+    const int64_t hist = st->ne[0], C = st->ne[1], T = xt->ne[0];
+    if (T < 2 || T > 4 || hist < 1 || hist > 7 || xt->ne[1] != C || st->ne[2] != 1 || st->ne[3] != 1 || xt->ne[2] != 1 || xt->ne[3] != 1) return false;
+    if (st->nb[0] != sizeof(float) || cat->ne[0] != hist + T || cat->ne[1] != C || cat->ne[2] != 1 || cat->ne[3] != 1 || !ggml_is_contiguous(cat)) return false;
+    m.cat = cat;
+    int j = i, n_views = 0, last_cpy = -1;
+    for (;;) {
+        j = glue_next_computed(g, j);
+        if (j < 0) return false;
+        ggml_tensor * n = g->nodes[j];
+        if (n->op != GGML_OP_CPY) break;
+        const ggml_tensor * v = n->src[0], * d = n->src[1];
+        if (!v || !d || v->op != GGML_OP_VIEW || v->view_src != cat || v->ne[0] != hist || v->ne[1] != C || v->ne[2] != 1 || v->ne[3] != 1 ||
+            v->nb[0] != sizeof(float) || v->nb[1] != cat->nb[1] || v->view_offs % sizeof(float) != 0) return false;
+        const int vi = glue_index_of(g, v, i + 1);
+        if (vi < 0 || vi > j || ggml_node_get_use_count(g, vi) != 1) return false;   // the view feeds this copy only
+        const int64_t off = (int64_t) (v->view_offs / sizeof(float));
+        if (off < 0 || off > T) return false;
+        if (d->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32 || d->ne[0] != hist || d->ne[1] != C || d->ne[2] != 1 || d->ne[3] != 1 ||
+            d->nb[0] != sizeof(float)) return false;
+        if (off == T) {
+            if (m.state) return false;
+            m.state = n;
+        } else {
+            if (m.n_snap >= 4) return false;
+            m.snap[m.n_snap] = n; m.snap_off[m.n_snap] = off; m.n_snap++;
+        }
+        n_views++;
+        last_cpy = j;
+    }
+    const ggml_tensor * conv = g->nodes[j], * w = conv->src[1];
+    if (!m.state || conv->op != GGML_OP_SSM_CONV || conv->src[0] != cat || !w || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+        w->ne[0] != hist + 1 || w->ne[1] != C) return false;
+    if (conv->type != GGML_TYPE_F32 || conv->ne[0] != C || conv->ne[1] != T || conv->ne[2] != 1 || !ggml_is_contiguous(conv) || !f3_single(g, j)) return false;
+    if (ggml_node_get_use_count(g, i) != n_views + 1) return false;   // the copies' views and the conv: nothing else reads the concat
+    const int js = glue_next_computed(g, j);
+    if (js < 0) return false;
+    ggml_tensor * su = g->nodes[js];
+    if (su->op != GGML_OP_UNARY || ggml_get_unary_op(su) != GGML_UNARY_OP_SILU || su->src[0] != conv || su->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(su) || !ggml_are_same_shape(su, conv)) return false;
+    // overlaps: the new state may be the old one in place (same rows, same layout: each work-item reads its row first)
+    const ggml_tensor * sd = m.state->src[1];
+    const bool state_in_place = sd->data == st->data && sd->nb[1] == st->nb[1];
+    if (!state_in_place && glue_overlap(sd, st)) return false;
+    // mode 1: the SiLU output may be x^T exactly: output (c, t) at the address input (t, c) is read from
+    const bool out_on_x = su->data == xt->data && xt->nb[0] == (size_t) C * sizeof(float) && xt->nb[1] == sizeof(float);
+    const ggml_tensor * outs[6] = { sd, mode == 1 ? (const ggml_tensor *) su : cat };   // mode 2 writes the concat instead
+    int n_outs = 2;
+    for (int k = 0; k < m.n_snap; k++) outs[n_outs++] = m.snap[k]->src[1];
+    for (int a = 0; a < n_outs; a++) {
+        if (!(outs[a] == su && out_on_x) && glue_overlap(outs[a], xt)) return false;
+        if (glue_overlap(outs[a], w)) return false;
+        if (outs[a] != sd && glue_overlap(outs[a], st)) return false;
+        for (int b = a + 1; b < n_outs; b++) if (glue_overlap(outs[a], outs[b])) return false;
+    }
+    m.cat = cat; m.conv = conv; m.silu = su;
+    m.last = mode == 1 ? js : last_cpy;   // mode 2: the loop goes on at the SSM_CONV (the stock SSM_CONV + SILU fusion)
+    return true;
+}
+
+// DC: the taps when the stock kernel has a specialization for them (4), else 0 (its runtime loop); FULL: mode 1
+template <int DC, bool FULL>
+static void glue_conv_t_kernel(dpct::queue_ptr q, const glue_conv_t & m) {
+    const ggml_tensor * st = m.cat->src[0], * xt = m.cat->src[1], * w = m.conv->src[1];
+    const int64_t hist = st->ne[0], C = st->ne[1], T = xt->ne[0];
+    const int d_conv = (int) hist + 1;
+    const char * sd = (const char *) st->data; const size_t s1 = st->nb[1];
+    const char * xd = (const char *) xt->data; const size_t x0 = xt->nb[0], x1 = xt->nb[1];
+    const float * wd = (const float *) w->data;
+    float * od = (float *) m.silu->data;
+    char * cd = (char *) m.cat->data; const size_t c1 = m.cat->nb[1];
+    char * nd = (char *) m.state->src[1]->data; const size_t n1 = m.state->src[1]->nb[1];
+    const int n_snap = m.n_snap;
+    char * pd[4] = {}; size_t p1[4] = {}; int64_t po[4] = {};
+    for (int k = 0; k < n_snap; k++) { pd[k] = (char *) m.snap[k]->src[1]->data; p1[k] = m.snap[k]->src[1]->nb[1]; po[k] = m.snap_off[k]; }
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(((C + 255) / 256) * 256), sycl::range<1>(256)), [=](sycl::nd_item<1> it) {
+        const int64_t c = it.get_global_id(0);
+        if (c >= C) return;
+        float p[12];
+        for (int64_t h = 0; h < hist; h++) p[h] = *(const float *) (sd + c * s1 + h * sizeof(float));
+        for (int64_t t = 0; t < T; t++) p[hist + t] = *(const float *) (xd + t * x0 + c * x1);
+        if constexpr (FULL) {
+            const float * cw = wd + c * d_conv;
+            for (int64_t t = 0; t < T; t++) {
+                const float * s = p + t;
+                float sumf = 0.0f;
+                if constexpr (DC > 0) {
+#pragma unroll
+                    for (int i0 = 0; i0 < DC; ++i0) sumf += s[i0] * cw[i0];
+                } else {
+                    for (int i0 = 0; i0 < d_conv; ++i0) sumf += s[i0] * cw[i0];
+                }
+                od[t * C + c] = op_silu(sumf);
+            }
+        } else {
+            for (int64_t k = 0; k < hist + T; k++) *(float *) (cd + c * c1 + k * sizeof(float)) = p[k];
+        }
+        for (int64_t h = 0; h < hist; h++) *(float *) (nd + c * n1 + h * sizeof(float)) = p[T + h];
+        for (int k = 0; k < n_snap; k++)
+            for (int64_t h = 0; h < hist; h++) *(float *) (pd[k] + c * p1[k] + h * sizeof(float)) = p[po[k] + h];
+    });
+}
+
+static void glue_conv_t_run(dpct::queue_ptr q, const glue_conv_t & m, int mode) {
+    if (mode == 2)                     glue_conv_t_kernel<0, false>(q, m);
+    else if (m.cat->src[0]->ne[0] == 3) glue_conv_t_kernel<4, true>(q, m);
+    else                               glue_conv_t_kernel<0, true>(q, m);
+}
+
+// GGML_SYCL_FUSE_POOL: the QSA indexer's mean pool as the engine builds it: CONT of r strided views (r >= 2), each
+// added to the previous sum (the first two added together), then a SCALE, the next nodes the loop runs; every
+// intermediate read once. One work-item per element sums the views in that order (a + b is b + a bit for bit) and
+// writes scale * sum + bias, as scale_f32 does. Only the SCALE's output is written.
+static int glue_pool_match(const ggml_cgraph * g, int i, const ggml_tensor * views[8], int * n_views) {
+    const ggml_tensor * c0 = g->nodes[i];
+    auto cont_ok = [&](const ggml_tensor * c, const ggml_tensor * like) {
+        const ggml_tensor * v = c->src[0];
+        return c->op == GGML_OP_CONT && c->type == GGML_TYPE_F32 && ggml_is_contiguous(c) && v && v->type == GGML_TYPE_F32 &&
+               v->nb[0] == sizeof(float) && v->ne[2] == 1 && v->ne[3] == 1 && ggml_are_same_shape(v, c) && (!like || ggml_are_same_shape(c, like));
+    };
+    if (!cont_ok(c0, nullptr) || c0->ne[2] != 1 || c0->ne[3] != 1 || !f3_single(g, i)) return -1;
+    views[0] = c0->src[0];
+    int n = 1, prev = i;      // prev: the node holding the running sum (the first CONT, then each ADD)
+    int j = i;
+    for (;;) {
+        j = glue_next_computed(g, j);
+        if (j < 0) return -1;
+        const ggml_tensor * c = g->nodes[j];
+        if (c->op == GGML_OP_SCALE) break;
+        if (n >= 8 || !cont_ok(c, c0) || !f3_single(g, j)) return -1;
+        const int ja = glue_next_computed(g, j);
+        if (ja < 0) return -1;
+        const ggml_tensor * a = g->nodes[ja];
+        const ggml_tensor * p = g->nodes[prev];
+        if (a->op != GGML_OP_ADD || a->type != GGML_TYPE_F32 || !ggml_is_contiguous(a) || !ggml_are_same_shape(a, c0)) return -1;
+        if (!((a->src[0] == p && a->src[1] == c) || (a->src[0] == c && a->src[1] == p))) return -1;
+        if (!f3_single(g, ja)) return -1;
+        views[n++] = c->src[0];
+        prev = ja; j = ja;
+    }
+    const ggml_tensor * sc = g->nodes[j];
+    if (n < 2 || sc->src[0] != g->nodes[prev] || sc->type != GGML_TYPE_F32 || !ggml_is_contiguous(sc) || !ggml_are_same_shape(sc, c0)) return -1;
+    for (int k = 0; k < n; k++) if (glue_overlap(sc, views[k])) return -1;
+    *n_views = n;
     return j;
+}
+
+static void glue_pool(dpct::queue_ptr q, const ggml_tensor * const views[8], int n_views, ggml_tensor * sc) {
+    struct vv { const char * d; size_t nb1; } v[8] = {};
+    for (int k = 0; k < n_views; k++) { v[k].d = (const char *) views[k]->data; v[k].nb1 = views[k]->nb[1]; }
+    const int64_t ne0 = sc->ne[0], n = ggml_nelements(sc);
+    float scale, bias;
+    memcpy(&scale, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&bias,  (const float *) sc->op_params + 1, sizeof(float));
+    float * od = (float *) sc->data;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(((n + 255) / 256) * 256), sycl::range<1>(256)), [=](sycl::nd_item<1> it) {
+        const int64_t e = it.get_global_id(0);
+        if (e >= n) return;
+        const size_t off = (size_t) (e % ne0) * sizeof(float);
+        const int64_t r = e / ne0;
+        float acc = *(const float *) (v[0].d + r * v[0].nb1 + off) + *(const float *) (v[1].d + r * v[1].nb1 + off);
+        for (int k = 2; k < n_views; k++) acc = acc + *(const float *) (v[k].d + r * v[k].nb1 + off);
+        od[e] = scale * acc + bias;
+    });
+}
