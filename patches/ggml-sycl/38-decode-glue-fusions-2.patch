+// ---- decode glue fusions, round 2 (patch 38) ----
+
+// The index of node t in g (searching from `from` on), or -1.
+static int glue_index_of(const ggml_cgraph * g, const ggml_tensor * t, int from) {
+    for (int k = from; k < g->n_nodes; k++) if (g->nodes[k] == t) return k;
+    return -1;
