+// GGML_SYCL_FUSE_MASK: the sparse attention's cell mask as the engine builds it: SUB(cell positions [N, T], n_past [1, T]
+// broadcast over dim 0) -> SCALE -> STEP -> SCALE -> CPY to f16, the next nodes the loop runs, every intermediate read
+// once. One work-group evaluates every element's five steps (each rounded to f32 as the separate kernels store it) and
+// the f16 conversion of the CPY into local memory, then writes them after a barrier: the allocator may give the CPY's
+// output the cell positions' memory (dead after the SUB), so every read comes before any write. At most GLUE_MASK_MAX
+// elements (local memory of one work-group).
+#define GLUE_MASK_MAX 16384
+#define GLUE_MASK_WG  512
+struct glue_mask { const ggml_tensor * sub, * s1, * s2; ggml_tensor * cpy; int last; };
+
+static bool glue_mask_match(const ggml_cgraph * g, int i, glue_mask & m) {
+    const ggml_tensor * sub = g->nodes[i];
+    if (sub->op != GGML_OP_SUB || sub->type != GGML_TYPE_F32 || !ggml_is_contiguous(sub) || !f3_single(g, i)) return false;
+    const ggml_tensor * a = sub->src[0], * b = sub->src[1];
+    if (!a || !b || a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || !ggml_is_contiguous(a) || !ggml_are_same_shape(a, sub)) return false;
+    if (sub->ne[2] != 1 || sub->ne[3] != 1 || b->ne[0] != 1 || b->ne[1] != sub->ne[1] || b->ne[2] != 1 || b->ne[3] != 1) return false;
+    if (ggml_nelements(sub) < 1 || ggml_nelements(sub) > GLUE_MASK_MAX) return false;
+    int idx[4]; const ggml_tensor * n[4];
+    int j = i;
+    for (int k = 0; k < 4; k++) { j = glue_next_computed(g, j); if (j < 0) return false; idx[k] = j; n[k] = g->nodes[j]; }
+    const ggml_tensor * prev = sub;
+    const ggml_op want[3] = { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE };
+    for (int k = 0; k < 3; k++) {
+        if (n[k]->op != want[k] || n[k]->src[0] != prev || n[k]->type != GGML_TYPE_F32 || !ggml_is_contiguous(n[k]) ||
+            !ggml_are_same_shape(n[k], sub) || !f3_single(g, idx[k])) return false;
+        prev = n[k];
+    }
+    if (ggml_get_unary_op(n[1]) != GGML_UNARY_OP_STEP) return false;
+    ggml_tensor * cp = g->nodes[idx[3]];
+    if (cp->op != GGML_OP_CPY || cp->src[0] != prev || cp->type != GGML_TYPE_F16 || !ggml_is_contiguous(cp) || ggml_nelements(cp) != ggml_nelements(sub)) return false;
+    m.sub = sub; m.s1 = n[0]; m.s2 = n[2]; m.cpy = cp; m.last = idx[3];
+    return true;
+}
+
+static void glue_mask_kernel(dpct::queue_ptr q, const glue_mask & m) {
+    const ggml_tensor * a = m.sub->src[0], * b = m.sub->src[1];
+    const int64_t ne0 = m.sub->ne[0], n = ggml_nelements(m.sub);
+    const float * ad = (const float *) a->data;
+    const char *  bd = (const char *) b->data; const size_t b1 = b->nb[1];
+    float sc1, bi1, sc2, bi2;
+    memcpy(&sc1, (const float *) m.s1->op_params + 0, sizeof(float)); memcpy(&bi1, (const float *) m.s1->op_params + 1, sizeof(float));
+    memcpy(&sc2, (const float *) m.s2->op_params + 0, sizeof(float)); memcpy(&bi2, (const float *) m.s2->op_params + 1, sizeof(float));
+    sycl::half * od = (sycl::half *) m.cpy->data;
+    q->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<sycl::half, 1> res(sycl::range<1>(n), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(GLUE_MASK_WG), sycl::range<1>(GLUE_MASK_WG)), [=](sycl::nd_item<1> it) {
+            for (int64_t e = it.get_local_id(0); e < n; e += GLUE_MASK_WG) {
+                const float x  = ad[e] - *(const float *) (bd + (e / ne0) * b1);
+                const float y1 = sc1 * x + bi1;
+                const float z  = y1 > 0.0f ? 1.0f : 0.0f;
+                const float y2 = sc2 * z + bi2;
+                res[e] = sycl::vec<float, 1>(y2).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+            }
+            it.barrier(sycl::access::fence_space::local_space);
+            for (int64_t e = it.get_local_id(0); e < n; e += GLUE_MASK_WG) od[e] = res[e];
+        });
+    });
 }
 
