+// ---- Q8_0_SOA one-token MoE matvec (patch 31) ----
+// One expert's slice: the 32 code bytes of block (row, b) at slice + blk*32 (16-byte aligned), its scale in the half
+// array after all the slice's codes. A lane takes a 16-byte half block per step, so a row of `bpr` blocks is 2*bpr
+// contiguous chunks shared by LPR lanes (q8_0 expert-down rows here are 20 blocks = 40 chunks: LPR 8 -> 5 full steps).
+// The arithmetic is vec_dot_q8_0_q8_1's (d_w * d_y * sum q_w*q_y), summed per half block.
+template <int LPR>
+static void mul_mat_vec_q8_0_soa_moe(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride,
+    const sycl::nd_item<3> & it) {
+    constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+    const int expert_idx = it.get_group(1);
+    const int i02        = ids_dev[expert_idx];
+    const int lane       = it.get_local_id(2);
+    const int row        = (it.get_group(2) * it.get_local_range(1) + it.get_local_id(1)) * ROWS_PER_SG + lane / LPR;
+    const int t          = lane % LPR;
+
+    const uint8_t *    slice = (const uint8_t *) vx_base + (size_t) i02 * expert_weight_stride;
+    const block_q8_1 * y     = (const block_q8_1 *) ((const char *) vy_base + (size_t) expert_idx * src1_row_stride);
+    float *            dst   = (float *) ((char *) dst_base + (size_t) expert_idx * dst_row_stride);
+
+    const int bpr = ncols / QK8_0;
+    const sycl::half * scales = (const sycl::half *) (slice + (size_t) nrows * bpr * QK8_0);
+    float acc = 0.0f;
+    if (row < nrows) {
+        const uint8_t * rq = slice + (size_t) row * bpr * QK8_0;
+        for (int c = t; c < 2 * bpr; c += LPR) {
+            const int b = c >> 1, h = c & 1;
+            const sycl::uint4 q = *(const sycl::uint4 *) (rq + (size_t) c * 16);
+            const int * u = (const int *) y[b].qs + 4 * h;
+            int sumi = 0;
+            sumi = dpct::dp4a((int) q.x(), u[0], sumi);
+            sumi = dpct::dp4a((int) q.y(), u[1], sumi);
+            sumi = dpct::dp4a((int) q.z(), u[2], sumi);
+            sumi = dpct::dp4a((int) q.w(), u[3], sumi);
+            acc += (float) scales[(size_t) row * bpr + b] * (float) y[b].ds[0] * (float) sumi;
+        }
+    }
+#pragma unroll
+    for (int mask = LPR / 2; mask > 0; mask >>= 1) {
+        acc += dpct::permute_sub_group_by_xor(it.get_sub_group(), acc, mask);
+    }
+    if (row < nrows && t == 0) {
+        dst[row] = acc;
+    }
+}
+
+static void launch_mul_mat_vec_q8_0_soa_moe(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows, const int n_experts_used,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride, dpct::queue_ptr stream) {
+    const int chunks = 2 * (ncols / QK8_0);
+    constexpr int SG_PER_WG = 4;
+    // GGML_SYCL_Q8_SOA_LPR=16|8|4 forces the lanes per row (tuning); otherwise the widest that leaves no lane idle
+    // on the last step, else 16
+    static const int lpr_env = [] { const char * e = getenv("GGML_SYCL_Q8_SOA_LPR"); return e ? atoi(e) : 0; }();
+    const int lpr = lpr_env ? lpr_env : chunks % WARP_SIZE == 0 ? WARP_SIZE : chunks % (WARP_SIZE / 2) == 0 ? WARP_SIZE / 2
+                                      : chunks % (WARP_SIZE / 4) == 0 ? WARP_SIZE / 4 : WARP_SIZE;
+    auto go = [&](auto lpr_tag) {
+        constexpr int LPR = decltype(lpr_tag)::value;
+        constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+        const int n_sg = (nrows + ROWS_PER_SG - 1) / ROWS_PER_SG;
+        const sycl::range<3> block_nums(1, (unsigned) n_experts_used, (unsigned) ((n_sg + SG_PER_WG - 1) / SG_PER_WG));
+        const sycl::range<3> block_dims(1, SG_PER_WG, WARP_SIZE);
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    mul_mat_vec_q8_0_soa_moe<LPR>(vx_base, vy, dst_base, ids_dev, ncols, nrows,
+                        expert_weight_stride, dst_row_stride, src1_row_stride, item);
+                });
+        });
+    };
+    if (lpr >= WARP_SIZE)          go(std::integral_constant<int, WARP_SIZE>{});
+    else if (lpr >= WARP_SIZE / 2) go(std::integral_constant<int, WARP_SIZE / 2>{});
+    else                           go(std::integral_constant<int, WARP_SIZE / 4>{});
+}
