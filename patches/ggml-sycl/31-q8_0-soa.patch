+// Q8_0_SOA (patch 31): k elements of whole slices as [codes, 32 bytes per block][scales]; one work-item per element.
+template <typename dst_t>
+static void dequantize_q8_0_soa_sycl(const void * __restrict__ vx, dst_t * __restrict__ y, const int64_t k,
+                                     dpct::queue_ptr stream) {
+    const int64_t nblocks = k / QK8_0;
+    const int8_t * qs = (const int8_t *) vx;
+    const sycl::half * ds = (const sycl::half *) ((const uint8_t *) vx + nblocks * QK8_0);
