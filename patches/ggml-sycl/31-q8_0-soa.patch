+            if (ncols % QK8_0 != 0 || ((uintptr_t) vx_base | expert_weight_stride) % 16 != 0) return false;
+            launch_mul_mat_vec_q8_0_soa_moe(vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
+                expert_weight_stride, dst_row_stride, src1_row_stride, stream);
