     const uint32_t base_eq = (uint32_t) k - need;
 
+    // GGML_SYCL_TOPK_DETERMINISTIC=1: emit in column order through work-group scans instead of atomic slot
+    // grabs. The winners above the pivot come out in index order, and among pivot-equal columns (ties) the
+    // lowest indices win: the same indices in the same order every run. With the atomics, which tied columns
+    // fill the last slots, and the order of all of them, depend on lane timing.
+    if (deterministic) {
+        const auto grp = item_ct1.get_group();
+        uint32_t run_gt = 0, run_eq = 0;   // winners emitted by earlier tiles (uniform across the group)
+        for (int base = 0; base < ncols; base += block_size) {
+            const int col = base + tid;
+            uint32_t gt = 0, eq = 0;
+            if (col < ncols) {
+                const uint32_t kp = top_k_radix_key(src[col]) & mask;
+                gt = kp > prefix; eq = kp == prefix;
+            }
+            const uint32_t ex_gt = sycl::exclusive_scan_over_group(grp, gt, sycl::plus<uint32_t>());
+            const uint32_t ex_eq = sycl::exclusive_scan_over_group(grp, eq, sycl::plus<uint32_t>());
+            if (gt) dst_idx[run_gt + ex_gt] = col;
+            if (eq && run_eq + ex_eq < need) dst_idx[base_eq + run_eq + ex_eq] = col;
+            run_gt += sycl::reduce_over_group(grp, gt, sycl::plus<uint32_t>());
+            run_eq += sycl::reduce_over_group(grp, eq, sycl::plus<uint32_t>());
+        }
+        return;
+    }
     for (int col = tid; col < ncols; col += block_size) {
