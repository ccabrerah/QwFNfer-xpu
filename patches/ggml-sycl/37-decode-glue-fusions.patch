+// GGML_SYCL_FUSE_ADDCHAIN_VIEWS: f3_match_addchain's chain of 2-4 ADDs (each adds one more same-shape f32 operand to the
+// previous result, which has no other reader) also when view nodes sit between the ADDs, which f3_match_addchain (adjacent
+// nodes only) stops at. Same operands in the same order for f3_addchain; *last gets the last ADD's index.
+static int glue_addchain_match(const ggml_cgraph * g, int i, const float * ops[5], int * last) {
+    const ggml_tensor * a0 = g->nodes[i];
+    if (a0->op != GGML_OP_ADD || !f3_f32c(a0) || !f3_f32c(a0->src[0]) || !f3_f32c(a0->src[1])) return 0;
+    if (!ggml_are_same_shape(a0->src[0], a0) || !ggml_are_same_shape(a0->src[1], a0)) return 0;
+    ops[0] = (const float *) a0->src[0]->data; ops[1] = (const float *) a0->src[1]->data;
+    int L = 1, prev_i = i;
+    *last = i;
+    while (L < 4) {
+        const int j = glue_next_computed(g, prev_i);
+        if (j < 0) break;
+        const ggml_tensor * prev = g->nodes[prev_i], * a = g->nodes[j];
+        if (a->op != GGML_OP_ADD || !f3_f32c(a) || !ggml_are_same_shape(a, a0)) break;
+        const ggml_tensor * other = a->src[0] == prev ? a->src[1] : a->src[1] == prev ? a->src[0] : nullptr;
+        if (!other || other == prev || !f3_f32c(other) || !ggml_are_same_shape(other, a0)) break;
+        if (!f3_single(g, prev_i)) break;
+        ops[L + 1] = (const float *) other->data;
+        L++; prev_i = j; *last = j;
+    }
+    return L >= 2 ? L : 0;
 }
 
+// GGML_SYCL_FUSE_SCALE_SILU: SCALE (f32) whose next node is a SILU of it.
+static bool glue_scale_silu_ok(const ggml_cgraph * g, int i) {
+    const ggml_tensor * sc = g->nodes[i];
+    if (sc->op != GGML_OP_SCALE || i + 1 >= g->n_nodes) return false;
+    const ggml_tensor * un = g->nodes[i + 1], * x = sc->src[0];
+    if (un->op != GGML_OP_UNARY || ggml_get_unary_op(un) != GGML_UNARY_OP_SILU || un->src[0] != sc || !(un->flags & GGML_TENSOR_FLAG_COMPUTE)) return false;
+    if (x->type != GGML_TYPE_F32 || sc->type != GGML_TYPE_F32 || un->type != GGML_TYPE_F32) return false;
+    if (!ggml_is_contiguous(x) || !ggml_is_contiguous(sc) || !ggml_is_contiguous(un)) return false;
+    if (ggml_nelements(x) != ggml_nelements(sc) || ggml_nelements(un) != ggml_nelements(sc) || ggml_nelements(sc) >= INT32_MAX) return false;
+    // element i of every buffer is touched by work-item i only: x may be either output, the outputs may be one buffer
+    if (x->data != sc->data && glue_overlap(x, sc)) return false;
+    if (x->data != un->data && glue_overlap(x, un)) return false;
+    if (sc->data != un->data && glue_overlap(sc, un)) return false;
+    return true;
+}
