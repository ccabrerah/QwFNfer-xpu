+// The next-layer predictor's tail as one kernel: the argsort's first k per row (lane 0 writes them, as above), then lane 0
+// copies them out as the graph's CPY (i32 -> f32), CONT and GET_ROWS of the row's own values would: x[row][id] read
+// again from the row, so a NaN comes out as GET_ROWS returns it (the selection saw it as -FLT_MAX).
+void ggml_sycl_topkwg_predict(dpct::queue_ptr stream, const float * x, int32_t * dst, int64_t ncols, int64_t nrows,
+                              int64_t x_row_stride, int k, float * ids_f32, int32_t * ids_i32, float * vals) {
+    const int wg = (int) ncols;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> sv(sycl::range<1>(2 * TOPKWG_MAX_SG), cgh);
+        sycl::local_accessor<int, 1>   si(sycl::range<1>(2 * TOPKWG_MAX_SG), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) nrows * wg), sycl::range<1>(wg)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int64_t row = it.get_group(0);
+                const int lane = it.get_local_id(0);
+                const float * xr = x + row * x_row_stride;
+                float v = xr[lane];
+                if (sycl::isnan(v)) v = -FLT_MAX;
+                int32_t * d = dst + row * ncols;
+                wg_topk<false>(it, v, k, d, nullptr,
+                               sv.get_multi_ptr<sycl::access::decorated::no>().get(),
+                               si.get_multi_ptr<sycl::access::decorated::no>().get());
+                if (lane == 0) {   // the ids lane 0 itself wrote in wg_topk
+                    for (int j = 0; j < k; j++) {
+                        const int32_t id = d[j];
+                        ids_f32[row * k + j] = (float) id;
+                        if (ids_i32) ids_i32[row * k + j] = id;
+                        vals[row * k + j] = xr[id];
+                    }
+                }
+            });
+    });
+}
