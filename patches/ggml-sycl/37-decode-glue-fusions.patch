+// GGML_SYCL_FUSE_ROUTE_GATHER, the in-graph MoE's residency lookups (decode and verify steps):
+//  (a) CONT of the routed ids (a strided view when a step has several positions) whose next node is a GET_ROWS of a
+//      [1, n] i32 table (the layer's VRAM slots) at those ids: one kernel writes the CONT and the gathered slots;
+//  (b) GET_ROWS of a [1, n] f32 table (the residency mask) whose next node is a MUL of it with the gate weights, same
+//      shape: one kernel writes the gathered mask and the product (operands in the MUL's order).
+// Returns the GET_ROWS (a) or MUL (b) index, or -1.
+static int glue_route_match_a(const ggml_cgraph * g, int i) {
+    const ggml_tensor * ct = g->nodes[i], * src = ct->src[0];
+    if (ct->op != GGML_OP_CONT || ct->type != GGML_TYPE_I32 || !src || src->type != GGML_TYPE_I32 || !ggml_is_contiguous(ct)) return -1;
+    if (src->ne[2] != 1 || src->ne[3] != 1 || !ggml_are_same_shape(src, ct) || src->nb[0] != sizeof(int32_t)) return -1;
+    const int j = glue_next_computed(g, i);
+    if (j < 0) return -1;
+    const ggml_tensor * gr = g->nodes[j], * tab = gr->src[0], * ids = gr->src[1];
+    const int64_t n = ggml_nelements(ct);
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_I32 || !ggml_is_contiguous(gr) || !tab || !ids) return -1;
+    if (tab->type != GGML_TYPE_I32 || !ggml_is_contiguous(tab) || tab->ne[0] != 1 || tab->ne[2] != 1 || tab->ne[3] != 1) return -1;
+    if (ids->type != GGML_TYPE_I32 || (ids != ct && (ids->view_src != ct || ids->view_offs != 0)) || !ggml_is_contiguous(ids) ||
+        ggml_nelements(ids) != n || ids->ne[0] != n) return -1;
+    if (gr->ne[0] != 1 || gr->ne[1] != n || gr->ne[2] != 1 || gr->ne[3] != 1 || n >= INT32_MAX) return -1;
+    if (glue_overlap(ct, src) || glue_overlap(ct, tab) || glue_overlap(gr, src) || glue_overlap(gr, tab) || glue_overlap(gr, ct)) return -1;
+    return j;
+}
+
+static void glue_route_a(dpct::queue_ptr q, const ggml_tensor * ct, ggml_tensor * gr) {
+    const ggml_tensor * src = ct->src[0], * tab = gr->src[0];
+    const int64_t n = ggml_nelements(ct), u = src->ne[0];
+    const char * sd = (const char *) src->data; const size_t s1 = src->nb[1];
+    const char * td = (const char *) tab->data; const size_t t1 = tab->nb[1];
+    int32_t * cd = (int32_t *) ct->data;
+    int32_t * od = (int32_t *) gr->data;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(((n + 63) / 64) * 64), sycl::range<1>(64)), [=](sycl::nd_item<1> it) {
+        const int64_t e = it.get_global_id(0);
+        if (e >= n) return;
+        const int32_t id = *(const int32_t *) (sd + (e % u) * sizeof(int32_t) + (e / u) * s1);
+        cd[e] = id;
+        od[e] = *(const int32_t *) (td + (size_t) id * t1);
+    });
+}
