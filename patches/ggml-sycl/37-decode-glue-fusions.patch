+// ---- decode glue fusions (patch 37) ----
+// Small kernels of the decode layer graphs merged into their neighbour, each behind its own switch. A fused kernel writes
+// every output the kernels it replaces wrote (other readers see the same bytes) and evaluates the same expressions in the
+// same order, so the results are bit-identical; the merged nodes must be the next ones the compute loop would run.
+
+// The next node after k that the compute loop runs (not a view or no-op, flagged for compute), or -1.
+static int glue_next_computed(const ggml_cgraph * g, int k) {
+    for (int j = k + 1; j < g->n_nodes; j++) {
+        const ggml_tensor * n = g->nodes[j];
+        if (!ggml_sycl_is_view_or_noop(n) && (n->flags & GGML_TENSOR_FLAG_COMPUTE)) return j;
+    }
+    return -1;
+}
+
+static bool glue_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * a0 = (const char *) a->data, * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
