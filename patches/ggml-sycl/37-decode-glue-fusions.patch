+// GGML_SYCL_FUSE_GATE_BCAST: UNARY (sigmoid | silu | softplus) of a [1, rows...] f32 tensor whose next node is a MUL that
+// broadcasts it over the other operand's dim 0 (the shared expert's gate). A UNARY in place over its input is accepted
+// only as the MUL's sole input (its output is then not written: other work-items still read the input).
+static bool glue_gate_bcast_ok(const ggml_cgraph * g, int i) {
+    const ggml_tensor * un = g->nodes[i];
+    if (un->op != GGML_OP_UNARY || i + 1 >= g->n_nodes) return false;
+    const ggml_unary_op uop = ggml_get_unary_op(un);
+    if (uop != GGML_UNARY_OP_SIGMOID && uop != GGML_UNARY_OP_SILU && uop != GGML_UNARY_OP_SOFTPLUS) return false;
+    const ggml_tensor * mul = g->nodes[i + 1], * gx = un->src[0];
+    if (mul->op != GGML_OP_MUL || !(mul->flags & GGML_TENSOR_FLAG_COMPUTE)) return false;
+    if ((mul->src[0] == un) == (mul->src[1] == un)) return false;   // exactly one operand is the unary
+    const ggml_tensor * other = mul->src[0] == un ? mul->src[1] : mul->src[0];
+    if (gx->type != GGML_TYPE_F32 || un->type != GGML_TYPE_F32 || other->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32) return false;
+    if (!ggml_is_contiguous(gx) || !ggml_is_contiguous(un) || !ggml_is_contiguous(other) || !ggml_is_contiguous(mul)) return false;
+    if (gx->ne[0] != 1 || other->ne[0] < 2 || !ggml_are_same_shape(gx, un) || !ggml_are_same_shape(other, mul)) return false;
+    if (gx->ne[1] != other->ne[1] || gx->ne[2] != other->ne[2] || gx->ne[3] != other->ne[3]) return false;
+    if (un->data == gx->data && ggml_node_get_use_count(g, i) != 1) return false;
+    if (glue_overlap(mul, gx) || glue_overlap(mul, un) || (un->data != gx->data && glue_overlap(un, gx))) return false;
+    if (other->data != mul->data && glue_overlap(other, mul)) return false;
+    return true;
+}
