+static int glue_route_match_b(const ggml_cgraph * g, int i, bool * gather_first) {
+    const ggml_tensor * gr = g->nodes[i], * tab = gr->src[0], * ids = gr->src[1];
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 || !ggml_is_contiguous(gr) || !tab || !ids) return -1;
+    if (tab->type != GGML_TYPE_F32 || !ggml_is_contiguous(tab) || tab->ne[0] != 1 || tab->ne[2] != 1 || tab->ne[3] != 1) return -1;
+    const int64_t n = ggml_nelements(ids);
+    if (ids->type != GGML_TYPE_I32 || !ggml_is_contiguous(ids) || ids->ne[0] != n || n >= INT32_MAX) return -1;
+    if (gr->ne[0] != 1 || gr->ne[1] != n || gr->ne[2] != 1 || gr->ne[3] != 1) return -1;
+    const int j = glue_next_computed(g, i);
+    if (j < 0) return -1;
+    const ggml_tensor * mul = g->nodes[j], * a = mul->src[0], * b = mul->src[1];
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) || ggml_nelements(mul) != n || !a || !b) return -1;
+    if (!ggml_are_same_shape(a, b) || !ggml_are_same_shape(a, mul)) return -1;
+    auto is_gather = [&](const ggml_tensor * t) { return t == gr || (t->view_src == gr && t->view_offs == 0 && ggml_is_contiguous(t)); };
+    if (is_gather(a) == is_gather(b)) return -1;   // exactly one operand is the gathered mask
+    *gather_first = is_gather(a);
+    const ggml_tensor * w = *gather_first ? b : a;
+    if (w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w)) return -1;
+    if (glue_overlap(gr, ids) || glue_overlap(gr, tab) || glue_overlap(gr, w) || glue_overlap(mul, tab)) return -1;
+    // the MUL may take the ids' buffer once they are dead (the allocator does): exactly, element for element -- each
+    // work-item reads its id before it writes its product
+    if (glue_overlap(mul, ids) && !(mul->data == ids->data && ggml_nbytes(mul) == ggml_nbytes(ids))) return -1;
+    if (mul->data != w->data && glue_overlap(mul, w)) return -1;
+    if (mul->data != gr->data && glue_overlap(mul, gr)) return -1;
+    return j;
+}
+
+static void glue_route_b(dpct::queue_ptr q, ggml_tensor * gr, ggml_tensor * mul, bool gather_first) {
+    const ggml_tensor * tab = gr->src[0];
+    const int64_t n = ggml_nelements(gr);
+    const char *    td = (const char *) tab->data; const size_t t1 = tab->nb[1];
+    const int32_t * id = (const int32_t *) gr->src[1]->data;
+    const float *   wd = (const float *) (gather_first ? mul->src[1] : mul->src[0])->data;
+    float * gd = (float *) gr->data;
+    float * md = (float *) mul->data;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(((n + 63) / 64) * 64), sycl::range<1>(64)), [=](sycl::nd_item<1> it) {
+        const int64_t e = it.get_global_id(0);
+        if (e >= n) return;
+        const float m = *(const float *) (td + (size_t) id[e] * t1);
+        const float w = wd[e];
+        gd[e] = m;
+        md[e] = gather_first ? m * w : w * m;
+    });
+}
