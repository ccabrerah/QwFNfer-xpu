+// dst[i] = other[i] * op(g[i / n]) (operands in the MUL's order), and the UNARY's own output op(g[r]) for every row r
+// unless it is in place over g (the caller then makes sure the MUL is its only reader: other work-items still read g):
+// the op and the product rounded as the two kernels round them. Preconditions are the caller's; re-asserted here.
+void ggml_sycl_op_unary_mul_bcast0_fused(ggml_backend_sycl_context & ctx, ggml_tensor * unary_node, ggml_tensor * mul_node) {
+    scope_op_debug_print scope_dbg_print(__func__, mul_node, /*num_src=*/2);
 
+    const ggml_tensor * g = unary_node->src[0];
+    const bool unary_first = mul_node->src[0] == unary_node;
+    const ggml_tensor * other = unary_first ? mul_node->src[1] : mul_node->src[0];
+    GGML_ASSERT(other != unary_node);
+    GGML_ASSERT(g->type == GGML_TYPE_F32 && unary_node->type == GGML_TYPE_F32 && other->type == GGML_TYPE_F32 && mul_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(g) && ggml_is_contiguous(unary_node) && ggml_is_contiguous(other) && ggml_is_contiguous(mul_node));
+    GGML_ASSERT(g->ne[0] == 1 && ggml_are_same_shape(g, unary_node) && ggml_are_same_shape(other, mul_node));
+    GGML_ASSERT(g->ne[1] == other->ne[1] && g->ne[2] == other->ne[2] && g->ne[3] == other->ne[3]);
+
+    queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int64_t k = ggml_nelements(mul_node);
+    const int64_t n = mul_node->ne[0];
+    const float * gd = (const float *) g->data;
+    const float * od = (const float *) other->data;
+    float *       ud = unary_node->data == g->data ? nullptr : (float *) unary_node->data;
+    float *       dd = (float *) mul_node->data;
+    const size_t  num_blocks = ceil_div((size_t) k, (size_t) SYCL_GLU_BLOCK_SIZE);
+    const sycl::nd_range<1> range(num_blocks * sycl::range<1>(SYCL_GLU_BLOCK_SIZE), sycl::range<1>(SYCL_GLU_BLOCK_SIZE));
+
+    dispatch_fused_unary_op(ggml_get_unary_op(unary_node), [&](auto op) {
+        main_stream->parallel_for(range, [=](sycl::nd_item<1> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int64_t i = item_ct1.get_global_id(0);
