index 686a4c7..480014e 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -5101,6 +5101,12 @@ static void mmid_counting_sort_rows(
     }
 }
 
+// GGML_SYCL_MMID_SMALL_T=1 (patch 01): a MUL_MAT_ID of up to 8 tokens runs the fused one-token kernel per token
+static bool ggml_sycl_mmid_small_t_on() {
+    static const bool on = [] { const char * e = getenv("GGML_SYCL_MMID_SMALL_T"); return e && atoi(e) != 0; }();
+    return on;
+}
+
 static void ggml_sycl_mul_mat_id(ggml_backend_sycl_context & ctx,
                                  ggml_tensor *dst) try {
     scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/3);
@@ -5120,6 +5126,26 @@ static void ggml_sycl_mul_mat_id(ggml_backend_sycl_context & ctx,
         if (ggml_sycl_mul_mat_id_mmvq_fused(ctx, src0, src1, ids, dst)) {
             return;
         }
+    } else if (ggml_sycl_mmid_small_t_on() && ne12 <= 8 && ids->ne[1] == ne12 && ne13 == 1 && ids->ne[2] == 1) {
+        // GGML_SYCL_MMID_SMALL_T=1, few tokens (e.g. a speculative decoding verify): run the fused kernel on each token view, so ids stay on the device
+        // the fused checks do not depend on the token: all tokens take this path, or the first one declines
+        bool ok = true;
+        for (int64_t t = 0; t < ne12 && ok; t++) {
+            ggml_tensor src1_t = *src1;
+            src1_t.ne[2] = 1;
+            src1_t.data  = (char *) src1->data + t * nb12;
+            ggml_tensor ids_t = *ids;
+            ids_t.ne[1] = 1;
+            ids_t.data  = (char *) ids->data + t * ids->nb[1];
+            ggml_tensor dst_t = *dst;
+            dst_t.ne[2] = 1;
+            dst_t.data  = (char *) dst->data + t * nb2;
+            ok = ggml_sycl_mul_mat_id_mmvq_fused(ctx, src0, &src1_t, &ids_t, &dst_t);
+            GGML_ASSERT(ok || t == 0);
+        }
+        if (ok) {
+            return;
+        }
     }
 
     std::vector<char> ids_host(ggml_nbytes(ids));
