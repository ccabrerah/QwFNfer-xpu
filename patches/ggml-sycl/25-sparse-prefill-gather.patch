 // A lane owns LD = hd / SG consecutive dimensions (16 at hd = 256), so each head's partial output stays in registers.
 #include "sdattn.hpp"
 #include "ggml-impl.h"
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+#include <vector>
+#include <cmath>
 
