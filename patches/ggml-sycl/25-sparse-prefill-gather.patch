+    float * dst = (float *) fa->data;
+    dpct::queue_ptr stream = ctx.stream();
+    static const bool check = getenv("GGML_SYCL_SPF_CHECK") != nullptr;
+    if (check) {   // diagnostic: the gathered result into a scratch buffer; the dense nodes still run and are compared after
+        spf_check_pending.fa = fa;
