+        return 0;
+    }
+    static bool logged = false;
+    if (!logged) { logged = true; fprintf(stderr, "ggml-sycl: sparse prefill attention gathered: %d cells per query, T %lld, n_kv %lld\n", NC, (long long) T, (long long) n_kv); }
+    const char * Qd = (const char *) Q->data;
+    const size_t q_nb0 = Q->nb[0], q_nb1 = Q->nb[1], q_nb2 = Q->nb[2];
+    const uint8_t * kcd = (const uint8_t *) K->data, * vcd = (const uint8_t *) V->data;
+    const size_t row_bytes = K->nb[1], k_hs = K->nb[2], v_hs = V->nb[2];
+    const char * cd = (const char *) cells->data; const size_t c_nb1 = cells->nb[1];
+    const char * md = (const char *) causal->data; const size_t m_nb1 = causal->nb[1];
