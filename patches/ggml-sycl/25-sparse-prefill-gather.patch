+            if (spf_check_pending.buf) sycl::free(spf_check_pending.buf, *stream);
+            spf_check_pending.buf = sycl::malloc_device<float>(spf_check_pending.n, *stream);
+            spf_check_pending.cap = spf_check_pending.n;
+        }
+        dst = spf_check_pending.buf;
+    }
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<sycl::half, 1> sKV(sycl::range<1>(2 * TCELL * HD), cgh), sP(sycl::range<1>(MROWS * TCELL), cgh);
+        sycl::local_accessor<float, 1> sPart(sycl::range<1>(NSG * MROWS * TCELL), cgh), sCorr(sycl::range<1>(MROWS), cgh),
+                                       sBufMk(sycl::range<1>(CBUF), cgh);
+        sycl::local_accessor<int, 1> sBuf(sycl::range<1>(CBUF), cgh);
+        cgh.parallel_for(sycl::nd_range<2>(sycl::range<2>((size_t) T, (size_t) nh_kv * NSG * SG), sycl::range<2>(1, NSG * SG)),
+            [=](sycl::nd_item<2> it) [[sycl::reqd_sub_group_size(SG)]] {
+                auto lp = [](auto & acc) { return acc.template get_multi_ptr<sycl::access::decorated::no>().get(); };
+                sdpattn(Qd, q_nb0, q_nb1, q_nb2, kcd, vcd, row_bytes, k_hs, v_hs, cd, c_nb1, md, m_nb1,
+                        NC, in_kv, inh, inh_kv, scale, dst, lp(sKV), lp(sPart), lp(sP), lp(sCorr), lp(sBuf), lp(sBufMk), it);
+            });
+    });
+    if (check) return 0;
+    return ifa - i;   // nodes to skip after i (the FA included)
+}
+
+void ggml_sycl_spf_check_after(ggml_backend_sycl_context & ctx, const ggml_tensor * node) {
+    if (spf_check_pending.fa != node || !spf_check_pending.buf) return;
+    static int reported = 0;
+    dpct::queue_ptr stream = ctx.stream();
+    stream->wait();
+    std::vector<float> a(spf_check_pending.n), b(spf_check_pending.n);
+    stream->memcpy(a.data(), node->data, a.size() * sizeof(float)).wait();
+    stream->memcpy(b.data(), spf_check_pending.buf, b.size() * sizeof(float)).wait();
+    double maxd = 0, maxa = 0, sumd = 0; size_t nbad = 0;
+    for (size_t k = 0; k < a.size(); k++) {
+        const double d = std::fabs((double) a[k] - (double) b[k]);
+        if (!(d <= 1e30)) { nbad++; continue; }
+        maxd = std::max(maxd, d); maxa = std::max(maxa, (double) std::fabs(a[k])); sumd += d;
+    }
+    if (reported++ < 24)
+        fprintf(stderr, "spf check: T %lld: max |dense - gathered| %.3g (max |dense| %.3g), mean %.3g, non-finite %zu\n",
+                (long long) node->ne[2], maxd, maxa, sumd / a.size(), nbad);
+    spf_check_pending.fa = nullptr;
+}
