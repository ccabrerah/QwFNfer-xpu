+// GGML_SYCL_LIDX_DECODE=2 (patch 41): the same scores in another summation order, for speed. LPR lanes per key row
+// (by default 4 below 5,120 key blocks and 1 from there on; GGML_SYCL_LIDX_LPR = 1, 2, 4 or 8 forces one), each summing
+// its 128 / LPR dimensions in order for every (query, head),
+// then a log2(LPR)-step lane tree; the queries and head weights are staged once per work-group in local memory. Not
+// bit-identical to the kernels above (a different order of the same products), so the selected blocks can differ where
+// two scores are within rounding of each other at the top-k boundary. Up to 4 queries and 4 heads.
+template <int LPR>
+static void lightning_indexer_decode_fast_f16_sycl(
+        const char * q, const char * k, const char * w, const char * m, float * dst,
+        int n_head, int n_batch, int n_kv,
+        size_t nbq1, size_t nbq2, size_t nbk2, size_t nbw1, size_t nbm1, size_t nb1,
+        queue_ptr stream) {
+    constexpr int D = 128, DPL = D / LPR, WG = 128, ROWS = WG / LPR, MAXB = 4, MAXH = 4;
+    static_assert(DPL % 8 == 0, "8-value chunks");
+    const int n_groups = (n_kv + ROWS - 1) / ROWS;
+    const int nq = n_batch * n_head;
+    const size_t dst_b = nb1 / sizeof(float);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> qs(sycl::range<1>(MAXB * MAXH * D), cgh);
+        sycl::local_accessor<float, 1> ws(sycl::range<1>(MAXB * MAXH), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) n_groups * WG), sycl::range<1>(WG)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int lid = (int) it.get_local_id(0);
+                for (int i = lid; i < nq * D; i += WG) {
+                    const int b = i / (n_head * D), h = (i / D) % n_head, d = i % D;
+                    qs[i] = *(const float *) (q + (size_t) b * nbq2 + (size_t) h * nbq1 + (size_t) d * sizeof(float));
+                }
+                for (int i = lid; i < nq; i += WG) {
+                    ws[i] = *(const float *) (w + (size_t) (i / n_head) * nbw1 + (size_t) (i % n_head) * sizeof(float));
+                }
+                sycl::group_barrier(it.get_group());
+                const int  row    = (int) it.get_group(0) * ROWS + lid / LPR;
+                const int  sub    = lid % LPR;
+                const bool active = row < n_kv;   // inactive lanes still take part in the lane tree
+                const sycl::half * kr = (const sycl::half *) (k + (size_t) (active ? row : 0) * nbk2) + sub * DPL;
+                float acc[MAXB][MAXH];
+#pragma unroll
+                for (int b = 0; b < MAXB; b++)
+#pragma unroll
+                    for (int h = 0; h < MAXH; h++) acc[b][h] = 0.0f;
+#pragma unroll
+                for (int c = 0; c < DPL; c += 8) {
+                    const sycl::vec<sycl::half, 8> kh = *(const sycl::vec<sycl::half, 8> *) (kr + c);
+                    float kv[8];
+#pragma unroll
+                    for (int j = 0; j < 8; j++) kv[j] = static_cast<float>(kh[j]);
+#pragma unroll
+                    for (int b = 0; b < MAXB; b++) {
+                        if (b >= n_batch) break;
+#pragma unroll
+                        for (int h = 0; h < MAXH; h++) {
+                            if (h >= n_head) break;
+                            const float * qq = &qs[(b * n_head + h) * D + sub * DPL + c];
+#pragma unroll
+                            for (int j = 0; j < 8; j++) acc[b][h] += qq[j] * kv[j];
+                        }
+                    }
+                }
+                const auto sg = it.get_sub_group();
+#pragma unroll
+                for (int b = 0; b < MAXB; b++) {
+                    if (b >= n_batch) break;
+                    float score = 0.0f;
+#pragma unroll
+                    for (int h = 0; h < MAXH; h++) {
+                        if (h >= n_head) break;
+                        float dot = acc[b][h];
+#pragma unroll
+                        for (int mask = LPR / 2; mask > 0; mask >>= 1) dot += sycl::permute_group_by_xor(sg, dot, mask);
+                        score += sycl::max(dot, 0.0f) * ws[b * n_head + h];
+                    }
+                    if (active && sub == 0) {
+                        const sycl::half * m_base = (const sycl::half *) (m + (size_t) b * nbm1);
+                        dst[(size_t) row + (size_t) b * dst_b] = score + static_cast<float>(m_base[row]);
+                    }
+                }
+            });
+    });
+}
