+// Lanes per key row. Measured per call at 2 queries (us, exact / LPR 1 / LPR 4): 768 blocks 7.0 / 9.3 / 5.9, 3,072 blocks
+// 12.1 / 9.4 / 6.3, 15,000 blocks 43.1 / 10.2 / 23.8: one lane per row needs enough rows to fill the GPU, four lanes per
+// row grow with the rows; they cross near 5,000 blocks (~20K tokens of context).
+static int lightning_indexer_fast_lpr(int64_t n_kv) {
+    static const int forced = [] { const char * e = getenv("GGML_SYCL_LIDX_LPR"); const int l = e ? atoi(e) : 0; return l == 1 || l == 2 || l == 4 || l == 8 ? l : 0; }();
+    return forced ? forced : n_kv >= 5120 ? 1 : 4;
+}
+
+// GGML_SYCL_LIDX_CHECK=K (patch 41, diagnostic): with the fast kernel, also run the exact decode kernel on the same inputs and
+// compare on the host: the largest score difference, and how many of each query's top K blocks (K = the value, or 513)
+// differ between the two (ties to the lower index, as the deterministic top-k breaks them). A sync per call; summary
+// on stderr every 2,000 calls and at exit.
+struct lidx_check_stats {
+    long long calls = 0, rows = 0, rows_sel = 0, diff_blocks = 0, rows_diff = 0, max_diff_blocks = 0;
+    double max_abs = 0.0, max_rel = 0.0;
+    void print() const {
+        if (!calls) return;
+        fprintf(stderr, "[ggml-sycl lidx-check] %lld calls, %lld query rows (%lld with more blocks than K): selected blocks "
+                        "differing %lld in total, in %lld rows, at most %lld in a row; max |score diff| %.3g (relative %.3g)\n",
+                calls, rows, rows_sel, diff_blocks, rows_diff, max_diff_blocks, max_abs, max_rel);
+    }
+    ~lidx_check_stats() { print(); }
+};
+
+static void lightning_indexer_check(const float * fast_dev, const float * exact_dev, int n_batch, int n_kv, size_t dst_b,
+                                    queue_ptr stream) {
+    static lidx_check_stats st;
+    static const int K = [] { const int v = atoi(getenv("GGML_SYCL_LIDX_CHECK")); return v > 1 ? v : 513; }();
+    std::vector<float> a((size_t) n_batch * dst_b), e((size_t) n_batch * dst_b);
+    stream->memcpy(a.data(), fast_dev, a.size() * sizeof(float));
+    stream->memcpy(e.data(), exact_dev, e.size() * sizeof(float)).wait();
+    std::vector<int> ia(n_kv), ie(n_kv);
+    auto top = [&](const float * s, std::vector<int> & idx) {
+        for (int i = 0; i < n_kv; i++) idx[i] = i;
+        std::partial_sort(idx.begin(), idx.begin() + std::min(K, n_kv), idx.end(),
+                          [&](int x, int y) { return s[x] > s[y] || (s[x] == s[y] && x < y); });
+        std::sort(idx.begin(), idx.begin() + std::min(K, n_kv));
+    };
+    st.calls++;
+    for (int b = 0; b < n_batch; b++) {
+        const float * sa = a.data() + (size_t) b * dst_b, * se = e.data() + (size_t) b * dst_b;
+        for (int i = 0; i < n_kv; i++) {
+            if (!std::isfinite(se[i]) || !std::isfinite(sa[i])) continue;
+            const double d = std::fabs((double) sa[i] - se[i]);
+            st.max_abs = std::max(st.max_abs, d);
+            if (se[i] != 0.0f) st.max_rel = std::max(st.max_rel, d / std::fabs((double) se[i]));
+        }
+        st.rows++;
+        if (n_kv <= K) continue;   // every block is selected
+        st.rows_sel++;
+        top(sa, ia); top(se, ie);
+        std::vector<int> only;
+        std::set_difference(ia.begin(), ia.begin() + K, ie.begin(), ie.begin() + K, std::back_inserter(only));
+        st.diff_blocks += (long long) only.size();
+        if (!only.empty()) st.rows_diff++;
+        st.max_diff_blocks = std::max<long long>(st.max_diff_blocks, (long long) only.size());
+    }
+    if (st.calls % 2000 == 0) st.print();
 }
 
