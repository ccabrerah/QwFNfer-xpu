+// ---- IQ4_NL_SOA one-token MoE matvec (patch 17) ----
+// One expert's slice: codes of block (row, b) at slice + blk*16 (16-byte aligned), its scale in the half array
+// after all the slice's codes. The arithmetic per block is vec_dot_iq4_nl_q8_1's.
+// The codes decode through a 256-entry table in local memory (code byte -> the two values of its nibbles), built
+// per work-group: 2.75x the stock kernel, which is ALU-bound on its byte-permute lookup.
+template <int LPR>
+static void mul_mat_vec_iq4_nl_soa_moe(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride,
+    const sycl::nd_item<3> & it, uint16_t * lut) {
+    constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+    const int expert_idx = it.get_group(1);
+    const int i02        = ids_dev[expert_idx];
+    const int lane       = it.get_local_id(2);
+    const int row        = (it.get_group(2) * it.get_local_range(1) + it.get_local_id(1)) * ROWS_PER_SG + lane / LPR;
+    const int t          = lane % LPR;
+    {
+        const int lid = it.get_local_linear_id(), nl = (int) it.get_local_range().size();
+        for (int i = lid; i < 256; i += nl)
+            lut[i] = (uint16_t) ((uint8_t) kvalues_iq4nl[i & 0xf] | ((uint16_t) (uint8_t) kvalues_iq4nl[i >> 4] << 8));
+        sycl::group_barrier(it.get_group());
+    }
+
+    const uint8_t *    slice = (const uint8_t *) vx_base + (size_t) i02 * expert_weight_stride;
+    const block_q8_1 * y     = (const block_q8_1 *) ((const char *) vy_base + (size_t) expert_idx * src1_row_stride);
+    float *            dst   = (float *) ((char *) dst_base + (size_t) expert_idx * dst_row_stride);
+
+    const int bpr = ncols / QK4_NL;
+    const sycl::half * scales = (const sycl::half *) (slice + (size_t) nrows * bpr * 16);
+    float acc = 0.0f;
+    if (row < nrows) {
+        for (int b = t; b < bpr; b += LPR) {
+            const size_t blk = (size_t) row * bpr + b;
+            const sycl::uint4 q = *(const sycl::uint4 *) (slice + blk * 16);
+            const int * u = (const int *) y[b].qs;
+            int sumi = 0;
+            const uint32_t qw[4] = { q.x(), q.y(), q.z(), q.w() };
+#pragma unroll
+            for (int k = 0; k < 4; k++) {
+                int vx, vy;
+                uint32_t x = 0, yv = 0;
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    const uint32_t e = lut[(qw[k] >> (8 * j)) & 0xff];
+                    x |= (e & 0xffu) << (8 * j); yv |= (e >> 8) << (8 * j);
+                }
+                vx = (int) x; vy = (int) yv;
+                sumi = dpct::dp4a(vx, u[k], sumi);
+                sumi = dpct::dp4a(vy, u[k + 4], sumi);
+            }
+            acc += (float) scales[blk] * (float) y[b].ds[0] * (float) sumi;
+        }
+    }
+#pragma unroll
+    for (int mask = LPR / 2; mask > 0; mask >>= 1) {
+        acc += dpct::permute_sub_group_by_xor(it.get_sub_group(), acc, mask);
+    }
+    if (row < nrows && t == 0) {
+        dst[row] = acc;
+    }
+}
+
+static void launch_mul_mat_vec_iq4_nl_soa_moe(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows, const int n_experts_used,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride, dpct::queue_ptr stream) {
+    const int bpr = ncols / QK4_NL;
+    constexpr int SG_PER_WG = 4;
+    // GGML_SYCL_IQ4_SOA_LPR=32|16|8 forces the lanes per row (tuning); otherwise by row length
+    static const int lpr_env = [] { const char * e = getenv("GGML_SYCL_IQ4_SOA_LPR"); return e ? atoi(e) : 0; }();
+    const int lpr = lpr_env ? lpr_env : bpr >= WARP_SIZE ? WARP_SIZE : bpr >= WARP_SIZE / 2 ? WARP_SIZE / 2 : WARP_SIZE / 4;
+    auto go = [&](auto lpr_tag) {
+        constexpr int LPR = decltype(lpr_tag)::value;
+        constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+        const int n_sg = (nrows + ROWS_PER_SG - 1) / ROWS_PER_SG;
+        const sycl::range<3> block_nums(1, (unsigned) n_experts_used, (unsigned) ((n_sg + SG_PER_WG - 1) / SG_PER_WG));
+        const sycl::range<3> block_dims(1, SG_PER_WG, WARP_SIZE);
+        stream->submit([&](sycl::handler & cgh) {
+            sycl::local_accessor<uint16_t, 1> lut(sycl::range<1>(256), cgh);
+            cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    uint16_t * l = lut.get_multi_ptr<sycl::access::decorated::no>().get();
+                    mul_mat_vec_iq4_nl_soa_moe<LPR>(vx_base, vy, dst_base, ids_dev, ncols, nrows,
+                                                expert_weight_stride, dst_row_stride, src1_row_stride, item, l);
+                });
+        });
+    };
+    if (lpr >= WARP_SIZE)          go(std::integral_constant<int, WARP_SIZE>{});
+    else if (lpr >= WARP_SIZE / 2) go(std::integral_constant<int, WARP_SIZE / 2>{});
+    else                           go(std::integral_constant<int, WARP_SIZE / 4>{});
+}
