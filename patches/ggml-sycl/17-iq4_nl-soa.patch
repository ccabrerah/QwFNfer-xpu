+// IQ4_NL_SOA (patch 17): k elements of whole slices as [codes][scales]; one work-item per code byte, which holds
+// element j (low nibble) and element j + 16 (high nibble) of its block, as dequantize_iq4_nl.
+template <typename dst_t>
+static void dequantize_iq4_nl_soa_sycl(const void * __restrict__ vx, dst_t * __restrict__ y, const int64_t k,
+                                       dpct::queue_ptr stream) {
+    const int64_t nblocks = k / QK4_NL;
+    const uint8_t * qs = (const uint8_t *) vx;
+    const sycl::half * ds = (const sycl::half *) (qs + nblocks * 16);
+    stream->parallel_for(sycl::range<1>((size_t) nblocks * 16), [=](sycl::id<1> id) {
+        const int64_t g = id[0], ib = g / 16, j = g % 16;
+        const float d = (float) ds[ib];
+        const uint8_t q = qs[g];
+        y[ib * QK4_NL + j]      = (dst_t) (d * (float) kvalues_iq4nl[q & 0xf]);
+        y[ib * QK4_NL + j + 16] = (dst_t) (d * (float) kvalues_iq4nl[q >> 4]);
+    });
+}
