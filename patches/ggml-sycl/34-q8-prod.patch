+// ---- GGML_SYCL_Q8_PROD (see apply_q8p.py): one-token producers that also write the q8_1 reorder-SoA copy of their output.
+// One sub-group per 32 values, QK8_1/WARP_SIZE values per lane: the same blocks, lane order and reductions as
+// quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>, so the copy is bit-identical to the standalone launch's.
+template <typename F>
+static void unary_mul_q8_t1(const float * x, const float * g, float * dst, char * q8, const int k, queue_ptr stream, F op) {
+    constexpr int E = QK8_1 / WARP_SIZE;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (k / QK8_1) * WARP_SIZE), sycl::range<1>(WARP_SIZE)),
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             const size_t off = it.get_group(0) * QK8_1 + E * it.get_local_id(0);
+                             const sycl::vec<float, E> xv = *reinterpret_cast<const sycl::vec<float, E> *>(x + off);
+                             const sycl::vec<float, E> gv = *reinterpret_cast<const sycl::vec<float, E> *>(g + off);
+                             sycl::vec<float, E> v;
+#pragma unroll
+                             for (int i = 0; i < E; i++) {
+                                 v[i] = op(xv[i]) * gv[i];
+                             }
+                             *reinterpret_cast<sycl::vec<float, E> *>(dst + off) = v;
+                             q8_1_soa_store_block<E>(v, q8, k, it);
+                         });
+}
