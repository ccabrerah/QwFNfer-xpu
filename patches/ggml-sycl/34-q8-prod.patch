+// GGML_SYCL_Q8_PROD: one block (the sub-group's group id) of a ONE-ROW reorder-SoA q8_1 tensor, from values a producer
+// kernel holds in registers; what quantize_and_reorder_q8_1_soa writes for row 0, block `group id`.
+template <int ElementsPerWI>
+__dpct_inline__ static void q8_1_soa_store_block(const sycl::vec<float, ElementsPerWI> & vals, void * reordered_q8_tensor,
+                                                 const int kx, const sycl::nd_item<1> & it) {
+    auto col   = it.get_group(0);
+    auto wi_id = it.get_local_id(0);
+    sycl::vec<int8_t, ElementsPerWI> quantized_values;
+    float                            d   = 0.0f;
+    float                            sum = 0.0f;
+    quantize_q8_1_vals<ElementsPerWI>(vals, quantized_values, d, sum, it);
+    auto quant_ptr = (int8_t *) ((char *) reordered_q8_tensor + QK8_1 * col + wi_id * ElementsPerWI);
+    *reinterpret_cast<sycl::vec<int8_t, ElementsPerWI> *>(quant_ptr) = quantized_values;
+    auto ds_ptr = (sycl::half2 *) ((char *) reordered_q8_tensor + kx + col * sizeof(sycl::half2));
+    if (wi_id == 0) {
+        *ds_ptr = sycl::half2(sycl::half(d), sycl::half(sum));
+    }
+}
