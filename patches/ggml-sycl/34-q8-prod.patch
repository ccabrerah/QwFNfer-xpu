+bool ggml_sycl_q8p_unary_mul(ggml_backend_sycl_context & ctx, ggml_tensor * unary_node, ggml_tensor * mul_node, char * q8) {
+    const ggml_tensor * x = unary_node->src[0];
+    const ggml_tensor * g = (mul_node->src[0] == unary_node) ? mul_node->src[1] : mul_node->src[0];
+    if (g == unary_node || x->type != GGML_TYPE_F32 || g->type != GGML_TYPE_F32 || mul_node->type != GGML_TYPE_F32 ||
+        ggml_nelements(mul_node) != mul_node->ne[0] || mul_node->ne[0] % QK8_1 != 0 || !ggml_is_contiguous(mul_node) ||
+        !ggml_are_same_shape(x, g) || !ggml_are_same_shape(x, mul_node) || x->nb[0] != sizeof(float) ||
+        g->nb[0] != sizeof(float) || !q8p_ptr_ok(x->data) || !q8p_ptr_ok(g->data) || !q8p_ptr_ok(mul_node->data) ||
+        !q8p_ptr_ok(q8)) {
+        return false;
+    }
+    scope_op_debug_print scope_dbg_print(__func__, mul_node, /*num_src=*/2);
+    queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    const int k = (int) mul_node->ne[0];
+    const float * xp = (const float *) x->data; const float * gp = (const float *) g->data; float * dp = (float *) mul_node->data;
+    switch (ggml_get_unary_op(unary_node)) {
+        case GGML_UNARY_OP_SILU:     unary_mul_q8_t1(xp, gp, dp, q8, k, stream, [](float v) { return op_silu(v); });     return true;
+        case GGML_UNARY_OP_SIGMOID:  unary_mul_q8_t1(xp, gp, dp, q8, k, stream, [](float v) { return op_sigmoid(v); });  return true;
+        case GGML_UNARY_OP_SOFTPLUS: unary_mul_q8_t1(xp, gp, dp, q8, k, stream, [](float v) { return op_softplus(v); }); return true;
+        default: return false;
+    }
+}
