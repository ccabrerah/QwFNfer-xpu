+// the q8r buffer sized for `src1`, as ggml_sycl_q8_direct_prepare sizes it
+static char * ggml_sycl_q8p_buffer(ggml_backend_sycl_context & ctx, const ggml_tensor * src1) {
+    ggml_sycl_set_device(ctx.device);
+    queue_ptr     stream = ctx.stream();
+    const int64_t padded = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING);
+    const size_t  bytes  = (size_t) padded * sizeof(block_q8_1) / QK8_1;
+    if (ctx.q8r_cap < bytes) {
+        if (ctx.q8r_buf) {
+            stream->wait();   // the in-order queue may still read the old copy
+            sycl::free(ctx.q8r_buf, *stream);
+        }
+        ctx.q8r_cap = std::max<size_t>(bytes, 128 * 1024);
+        ctx.q8r_buf = (char *) sycl::malloc_device(ctx.q8r_cap, *stream);
+        ctx.q8r_src1 = nullptr;   // the old copy is gone with the old buffer, whether or not the producer then declines
+    }
+    return ctx.q8r_buf;
+}
