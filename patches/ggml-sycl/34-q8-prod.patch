+bool ggml_sycl_q8p_swiglu(ggml_backend_sycl_context & ctx, ggml_tensor * dst, char * q8) {
+    if (dst->op != GGML_OP_GLU || ggml_get_glu_op(dst) != GGML_GLU_OP_SWIGLU) return false;
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (!src0 || src0->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || (src1 && src1->type != GGML_TYPE_F32)) return false;
+    const int64_t nc = src1 ? src0->ne[0] : src0->ne[0] / 2;
+    if (dst->ne[0] != nc || ggml_nelements(dst) != nc || nc % QK8_1 != 0 || !ggml_is_contiguous(dst) ||
+        src0->ne[1] != 1 || src0->ne[2] != 1 || src0->ne[3] != 1 || src0->nb[0] != sizeof(float) ||
+        (src1 && (src1->ne[0] != nc || src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->nb[0] != sizeof(float)))) {
+        return false;
+    }
+    const int32_t swapped = ((const int32_t *) dst->op_params)[1];
+    const float * xp = (const float *) src0->data;
+    const float * gp = src1 ? (const float *) src1->data : xp;
+    if (!src1) { xp += swapped ? nc : 0; gp += swapped ? 0 : nc; }
+    if (!q8p_ptr_ok(xp) || !q8p_ptr_ok(gp) || !q8p_ptr_ok(dst->data) || !q8p_ptr_ok(q8)) return false;
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    unary_mul_q8_t1(xp, gp, (float *) dst->data, q8, (int) nc, stream, [](float v) { return op_silu(v); });
+    return true;
+}
